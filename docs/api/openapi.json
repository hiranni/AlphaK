        }
      },
      "delete": {
        "tags": [
          "watchlist"
        ],
        "summary": "Delete item",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "删除普通分组条目仅移出该组；删除 watchlist-all 条目会取消关注，并同时删除该股所有分组归类。"
      }
    },
