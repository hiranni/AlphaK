    "/api/v1/watchlists": {
      "get": {
        "tags": [
          "watchlist"
        ],
        "summary": "List groups and items",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "返回全部自选与自定义分组。固定集合 watchlist-all 始终在首位，其股票跨组去重；无自定义分组时仍保留此入口。"
      },
      "post": {
        "tags": [
          "watchlist"
        ],
        "summary": "Create group",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/watchlists/refresh": {
      "post": {
        "tags": [
          "watchlist"
        ],
        "summary": "Refresh quotes for all watchlist items",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/watchlists/groups": {
      "post": {
        "tags": [
