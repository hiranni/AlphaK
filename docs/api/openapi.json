        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/watchlists/groups/{id}": {
      "put": {
        "tags": [
          "watchlist"
        ],
        "summary": "Rename group",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "watchlist"
        ],
        "summary": "Delete group",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "仅删除自定义分组及归类，保留全部自选中的股票；允许删除最后一个自定义分组。watchlist-all 不可删除。"
      }
    },
    "/api/v1/watchlists/items": {
      "post": {
        "tags": [
          "watchlist"
        ],
        "summary": "Add item",
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "添加收藏并可归类。group_id=watchlist-all 表示只收藏；其他 group_id 会在同一事务中先收藏再加入分组。重复加入不覆盖备注。"
      }
    },
    "/api/v1/watchlists/items/reorder": {
      "put": {
        "tags": [
          "watchlist"
        ],
        "summary": "Reorder items in a group",
