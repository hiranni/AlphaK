    "/api/v1/trading/research": {
      "get": {
        "summary": "List latest 100 immutable research configurations and latest reports; no account ledger",
        "responses": {
          "200": {
            "description": "Envelope of research configurations"
          }
        }
      },
      "post": {
        "summary": "Create scoped research configuration; unique models and total weight <= 1 validated in business layer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "symbols",
                  "allocations",
                  "sentiment_scope"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "symbols": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "sentiment_scope": {
                    "type": "string",
                    "enum": [
                      "pool",
                      "market"
                    ]
                  },
                  "allocations": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "model_id",
                        "weight"
                      ],
                      "properties": {
                        "model_id": {
                          "type": "string",
                          "enum": [
                            "ak-state-v1",
                            "ak-regime-v1",
                            "ak-continuation-v1",
                            "ak-repair-v1",
                            "ak-cooling-v1",
                            "ak-event-v1",
                            "ak-quality-v1",
                            "ak-ensemble-v1"
                          ]
                        },
                        "weight": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Envelope containing immutable id"
          },
          "400": {
            "description": "Invalid scope, weights or models"
          }
        }
      }
    },
