          "cooldown_minutes",
          "enabled"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "price_above",
              "price_below",
              "change_above",
              "change_below",
              "volume_ratio",
              "breakout",
              "support_break",
              "volatility"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "cooldown_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10080
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "example": {
              "code": 1,
              "message": "BAD_REQUEST: unknown dataset",
              "data": null,
              "request_id": "uuid"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found or not open",
        "content": {
          "application/json": {
            "example": {
              "code": 1,
              "message": "NOT_OPEN: 接口未开放或不存在；MVP 不包含该能力",
              "data": null,
              "request_id": "uuid"
            }
          }
        }
      }
    }
  }
