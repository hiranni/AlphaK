{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.alphak.local/strategy.schema.json",
  "title": "AlphaK Strategy Spec",
  "description": "Agent-readable strategy definition. A strategy MUST NOT trade more than 8 symbols and MUST NOT scan the full market.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "status",
    "characteristics",
    "objective",
    "universe",
    "data_requirements",
    "signals",
    "rules",
    "position_sizing",
    "risk",
    "execution",
    "evaluation",
    "explainability"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "Version of this strategy schema."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "description": "Stable strategy identifier. Never reuse after archive."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer of the strategy definition."
    },
    "status": {
      "enum": ["draft", "validated", "active", "paused", "archived"]
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "characteristics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Quantifiable strategy identity. Every field has a unit or a closed enum so an Agent can compare strategies.",
      "required": [
        "style",
        "horizon",
        "risk_level",
        "typical_holding_days",
        "expected_turnover_pct",
        "market_regime"
      ],
      "properties": {
        "style": {
          "enum": [
            "trend",
            "momentum",
            "mean_reversion",
            "value",
            "quality",
            "event_driven",
            "multi_factor",
            "other"
          ]
        },
        "horizon": {
          "enum": ["intraday", "daily", "weekly", "monthly", "quarterly"]
        },
        "risk_level": {
          "enum": ["low", "medium", "high"]
        },
        "typical_holding_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "description": "Median expected holding period in trading days."
        },
        "expected_turnover_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Expected annualized turnover as a decimal fraction; 0.3 means 30%."
        },
        "market_regime": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["trending", "ranging", "volatile", "bull", "bear", "all"]
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "benchmark", "horizon"],
      "properties": {
        "type": {
          "enum": [
            "absolute_return",
            "excess_return",
            "risk_adjusted_return",
            "drawdown_control"
          ]
        },
        "benchmark": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{2,32}$",
          "description": "Benchmark code, for example 000300.SH."
        },
        "horizon": {
          "enum": ["daily", "weekly", "monthly", "quarterly"]
        },
        "target": {
          "type": ["number", "null"],
          "description": "Optional annualized target as a decimal fraction."
        }
      }
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "symbols", "max_symbols"],
      "properties": {
        "mode": {
          "const": "static",
          "description": "Only a manually curated static universe is allowed."
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"
          },
          "description": "1-8 unique A-share symbols. No full-market or index-wide universe."
        },
        "max_symbols": {
          "const": 8,
          "description": "Hard product cap. Must equal 8 even when fewer symbols are used."
        },
        "exclude_st": {
          "type": "boolean",
          "default": true,
          "description": "Whether ST names are excluded from entries."
        }
      }
    },
    "data_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency", "lookback_days", "fields", "point_in_time"],
      "properties": {
        "frequency": {
          "enum": ["daily", "weekly", "monthly", "minute"]
        },
        "lookback_days": {
          "type": "integer",
          "minimum": 20,
          "maximum": 3650
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "open",
              "high",
              "low",
              "close",
              "volume",
              "amount",
              "turnover",
              "pe_ttm",
              "pb",
              "roe",
              "revenue",
              "net_profit",
              "free_cash_flow"
            ]
          }
        },
        "point_in_time": {
          "const": true,
          "description": "Financial data is available only after its announcement date."
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expression", "inputs", "output"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,31}$"
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Expression in the grammar defined in docs/specs/README.md."
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,31}$"
            }
          },
          "output": {
            "enum": ["boolean", "number"]
          },
          "description": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "exit"],
      "properties": {
        "entry": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/rule" }
        },
        "exit": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "position_sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "max_positions", "max_weight_per_symbol"],
      "properties": {
        "method": {
          "enum": ["equal_weight", "fixed_fraction", "volatility_target"]
        },
        "max_positions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_weight_per_symbol": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "cash_buffer": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stop_loss_pct",
        "max_drawdown_pct",
        "max_daily_turnover_pct"
      ],
      "properties": {
        "stop_loss_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "take_profit_pct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 5
        },
        "max_drawdown_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Hard stop; breach pauses the strategy and requires human review."
        },
        "max_daily_turnover_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_order_value": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum notional value of one order in CNY. 0 means no additional cap."
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency",
        "order_type",
        "fill_timing",
        "fees",
        "slippage_bps"
      ],
      "properties": {
        "frequency": {
          "enum": ["daily", "weekly", "monthly"]
        },
        "order_type": {
          "enum": ["market", "limit"]
        },
        "fill_timing": {
          "enum": ["next_open", "next_close", "same_close"],
          "description": "Auto strategies MUST use next_open or next_close."
        },
        "fees": { "$ref": "#/$defs/fees" },
        "slippage_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "min_track_days"],
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "total_return",
              "annualized_return",
              "max_drawdown",
              "sharpe",
              "calmar",
              "win_rate",
              "turnover"
            ]
          }
        },
        "min_track_days": {
          "type": "integer",
          "minimum": 20,
          "maximum": 3650
        }
      }
    },
    "explainability": {
      "type": "object",
      "additionalProperties": false,
      "description": "Replay-analysis cache policy. This is NOT performance/NAV data and MAY be pruned after retention.",
      "required": [
        "cache_granularity",
        "retention_periods",
        "include",
        "replay_modes",
        "redact_secrets"
      ],
      "properties": {
        "cache_granularity": {
          "enum": ["weekly", "monthly", "quarterly", "yearly"],
          "default": "quarterly",
          "description": "Storage and retention bucket size. Default is quarterly."
        },
        "retention_periods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 8,
          "description": "Number of cache_granularity periods to keep. Product default is 8 quarters; UI may apply granularity-specific defaults."
        },
        "include": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "context_snapshot",
              "signal_values",
              "rule_trace",
              "agent_prompt",
              "agent_response",
              "tool_calls",
              "validation_trace",
              "position_snapshot",
              "order_links"
            ]
          },
          "description": "Artifacts required for replay and explanation."
        },
        "replay_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["decision", "period"]
          },
          "description": "decision replays one decision; period replays every decision in the period."
        },
        "redact_secrets": {
          "const": true,
          "description": "Credentials and API keys MUST be removed before persistence."
        },
        "pinned_periods": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 16
          },
          "description": "Period keys exempt from automatic cleanup."
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Free-form metadata; MUST NOT contain secrets."
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "action"],
      "properties": {
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Boolean expression evaluated at bar close."
        },
        "action": {
          "enum": ["buy", "sell", "reduce", "hold"]
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        },
        "description": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "fees": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commission_bps",
        "stamp_duty_bps",
        "transfer_fee_bps",
        "min_commission"
      ],
      "properties": {
        "commission_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "stamp_duty_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "transfer_fee_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "min_commission": {
          "type": "number",
          "minimum": 0,
          "description": "Minimum commission per trade in CNY."
        }
      }
    }
  }
}
