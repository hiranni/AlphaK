{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaK research monitor, not executable trading strategy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "family",
    "version",
    "schema_version",
    "short",
    "long",
    "symbols",
    "rule",
    "risk",
    "mode"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "enum": [
        "trend",
        "breakout",
        "pullback",
        "momentum",
        "rebound",
        "boll_break",
        "boll_revert",
        "low_vol",
        "volume",
        "risk",
        "sentiment"
      ]
    },
    "version": {
      "const": 1
    },
    "schema_version": {
      "const": "research-monitor-1"
    },
    "short": {
      "type": "integer",
      "minimum": 10,
      "maximum": 60
    },
    "long": {
      "type": "integer",
      "minimum": 30,
      "maximum": 120
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\d{6}\\.(SH|SZ)$"
      }
    },
    "rule": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "mode": {
      "const": "signal_observation"
    }
  }
}
