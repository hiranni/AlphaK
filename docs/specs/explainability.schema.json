{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.alphak.local/explainability.schema.json",
  "title": "AlphaK Explainability Replay Bundle",
  "description": "Metadata for one explainability/replay cache bundle. This is analysis data, NOT performance or NAV data. Expired bundles may be deleted while trades and NAV remain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "strategy_instance_id",
    "granularity",
    "period_key",
    "status",
    "retention_periods",
    "expires_at",
    "included_artifacts",
    "decision_count",
    "checksum",
    "size_bytes",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,95}$"
    },
    "strategy_instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "granularity": {
      "enum": ["weekly", "monthly", "quarterly", "yearly"]
    },
    "period_key": {
      "type": "string",
      "maxLength": 16,
      "description": "2026-W43 for weekly, 2026-10 for monthly, 2026-Q4 for quarterly, 2026 for yearly."
    },
    "status": {
      "enum": ["available", "expired", "deleting", "deleted", "corrupt"]
    },
    "retention_periods": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "bundle_uri": {
      "type": "string",
      "format": "uri",
      "description": "Storage location of the compressed bundle. Required when status is available."
    },
    "included_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "context_snapshot",
          "signal_values",
          "rule_trace",
          "agent_prompt",
          "agent_response",
          "tool_calls",
          "validation_trace",
          "position_snapshot",
          "order_links"
        ]
      }
    },
    "decision_count": {
      "type": "integer",
      "minimum": 0
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the bundle content. Keep the checksum after deletion for audit."
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "Pinned bundles are exempt from automatic cleanup."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Free-form metadata; MUST NOT contain secrets or full prompts."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "granularity": { "const": "weekly" } },
        "required": ["granularity"]
      },
      "then": {
        "properties": {
          "period_key": { "pattern": "^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$" }
        }
      }
    },
    {
      "if": {
        "properties": { "granularity": { "const": "monthly" } },
        "required": ["granularity"]
      },
      "then": {
        "properties": {
          "period_key": { "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" }
        }
      }
    },
    {
      "if": {
        "properties": { "granularity": { "const": "quarterly" } },
        "required": ["granularity"]
      },
      "then": {
        "properties": {
          "period_key": { "pattern": "^[0-9]{4}-Q[1-4]$" }
        }
      }
    },
    {
      "if": {
        "properties": { "granularity": { "const": "yearly" } },
        "required": ["granularity"]
      },
      "then": {
        "properties": {
          "period_key": { "pattern": "^[0-9]{4}$" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "available" } },
        "required": ["status"]
      },
      "then": {
        "required": ["bundle_uri"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "deleted" } },
        "required": ["status"]
      },
      "then": {
        "required": ["deleted_at"],
        "properties": {
          "deleted_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  ]
}
