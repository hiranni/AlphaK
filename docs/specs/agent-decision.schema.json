{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.alphak.local/agent-decision.schema.json",
  "title": "AlphaK Agent Decision",
  "description": "Full Agent decision after the runtime injects the trusted envelope. Model-owned semantic output is validated separately against agent-response.schema.json; models MUST NOT generate envelope fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "strategy_instance_id",
    "agent_profile_id",
    "agent_profile_version",
    "as_of",
    "context_hash",
    "action",
    "orders",
    "rationale",
    "citations",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUID v4-style identifier generated by the runtime, not by the model."
    },
    "strategy_instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "agent_profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "agent_profile_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "description": "Decision timestamp with offset, ISO 8601."
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the canonical context package supplied to the Agent; injected by the runtime."
    },
    "action": {
      "enum": [
        "hold",
        "buy",
        "sell",
        "rebalance"
      ]
    },
    "orders": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/order"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_notes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "tool_calls": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/tool_call"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional non-authoritative metadata. The platform ignores unknown semantics."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "hold"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "orders": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "buy",
              "sell",
              "rebalance"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "orders": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "side",
        "quantity",
        "order_type",
        "reason"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "description": "Share count. Buys MUST be a multiple of 100; sells may include odd lots."
        },
        "order_type": {
          "enum": [
            "market",
            "limit"
          ]
        },
        "limit_price": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Required for limit orders; must be null or absent for market orders."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "order_type": {
                "const": "limit"
              }
            },
            "required": [
              "order_type"
            ]
          },
          "then": {
            "required": [
              "limit_price"
            ],
            "properties": {
              "limit_price": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "order_type": {
                "const": "market"
              }
            },
            "required": [
              "order_type"
            ]
          },
          "then": {
            "properties": {
              "limit_price": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "as_of"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Table, document, or tool identifier, for example quote_daily or indicator:SMA20."
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "field": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "started_at",
        "status"
      ],
      "properties": {
        "tool": {
          "enum": [
            "market.read",
            "fundamentals.read",
            "indicators.compute",
            "portfolio.read",
            "order.propose",
            "order.place",
            "alert.send",
            "backtest.read"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "timeout",
            "denied"
          ]
        },
        "args_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "error_code": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  }
}
